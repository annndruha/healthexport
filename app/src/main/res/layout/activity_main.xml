<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textColor="@color/hc_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Export your health data to CSV files"
            android:textColor="@color/hc_text_secondary"
            android:textSize="14sp" />

        <!-- Health Connect access -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Health Connect access"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPermissionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking permissions…" />

                <Button
                    android:id="@+id/btnGrantPermissions"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Grant Health Connect permissions" />

                <Button
                    android:id="@+id/btnGrantHistory"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow access to data older than 30 days" />

                <TextView
                    android:id="@+id/txtHistoryHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Without this, Health Connect only returns data from 30 days before the app was first given access. If the button has no effect, update Health Connect (or Android) to a version that supports past data access."
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Activity Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategoryActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutActivitySubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkActiveCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active calories burned" />

                    <CheckBox
                        android:id="@+id/checkDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance" />

                    <CheckBox
                        android:id="@+id/checkElevationGained"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elevation gained" />

                    <CheckBox
                        android:id="@+id/checkExercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exercise sessions" />

                    <CheckBox
                        android:id="@+id/checkFloorsClimbed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floors climbed" />

                    <CheckBox
                        android:id="@+id/checkPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Power" />

                    <CheckBox
                        android:id="@+id/checkSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed" />

                    <CheckBox
                        android:id="@+id/checkSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steps" />

                    <CheckBox
                        android:id="@+id/checkTotalCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total calories burned" />

                    <CheckBox
                        android:id="@+id/checkVO2Max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VO2 max" />

                    <CheckBox
                        android:id="@+id/checkWheelchairPushes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wheelchair pushes" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Body Measurements Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategoryBodyMeasurements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Body Measurements"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutBodyMeasurementsSubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkBodyFat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Body fat" />

                    <CheckBox
                        android:id="@+id/checkBoneMass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bone mass" />

                    <CheckBox
                        android:id="@+id/checkHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height" />

                    <CheckBox
                        android:id="@+id/checkLeanBodyMass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lean body mass" />

                    <CheckBox
                        android:id="@+id/checkWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cycle Tracking Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategoryCycleTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cycle Tracking"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutCycleTrackingSubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkCervicalMucus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cervical mucus" />

                    <CheckBox
                        android:id="@+id/checkMenstruation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menstruation" />

                    <CheckBox
                        android:id="@+id/checkOvulationTest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ovulation test" />

                    <CheckBox
                        android:id="@+id/checkSexualActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sexual activity" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nutrition Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategoryNutrition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nutrition"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutNutritionSubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkHydration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hydration" />

                    <CheckBox
                        android:id="@+id/checkNutrition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nutrition" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sleep Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategorySleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sleep"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutSleepSubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkSleepSession"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep sessions" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vitals Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/checkCategoryVitals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vitals"
                    android:textSize="16sp"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutVitalsSubtypes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/checkBloodGlucose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood glucose" />

                    <CheckBox
                        android:id="@+id/checkBloodPressure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood pressure" />

                    <CheckBox
                        android:id="@+id/checkBodyTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Body temperature" />

                    <!-- High-volume (*) -->
                    <CheckBox
                        android:id="@+id/checkHeartRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart rate (min/max/avg) *" />

                    <CheckBox
                        android:id="@+id/checkHeartRateVariability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart rate variability (min/max/avg) *" />

                    <CheckBox
                        android:id="@+id/checkOxygenSaturation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oxygen saturation (min/max/avg) *" />

                    <CheckBox
                        android:id="@+id/checkRespiratoryRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Respiratory rate (min/max/avg) *" />

                    <CheckBox
                        android:id="@+id/checkRestingHeartRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resting heart rate (min/max/avg)" />

                    <TextView
                        android:id="@+id/txtHighVolumeLegend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="* High-volume data. May take much longer (especially All time)."
                        android:textColor="#D32F2F"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date Range and Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/hc_card"
            app:strokeColor="@color/hc_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Date Range"
                    android:textColor="@color/hc_title"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerDateRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/date_ranges" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSaferExport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Safer export mode (slower)" />

                <TextView
                    android:id="@+id/txtSaferExportHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reduces rate-limit errors by exporting more slowly."
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtCsvSplitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="CSV split (for All time)"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerCsvSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/csv_split_options" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Export CSV to Downloads"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the app open while exporting: Health Connect does not allow reading data in the background."
            android:textAlignment="center"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:progressBackgroundTint="@color/hc_primary_container"
            android:progressTint="@color/hc_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="center"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status: Ready"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>